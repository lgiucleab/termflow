---
source: crates/termflow-providers/src/tests.rs
expression: "openai_responses::render(&transcript(), &ctx(\"openai\", \"cred-o\"))"
---
{
  "include": [
    "reasoning.encrypted_content"
  ],
  "input": [
    {
      "content": [
        {
          "text": "Read main.rs",
          "type": "input_text"
        }
      ],
      "role": "user"
    },
    {
      "content": [
        {
          "text": "Reading.",
          "type": "output_text"
        }
      ],
      "role": "assistant",
      "type": "message"
    },
    {
      "arguments": "{\"path\":\"src/main.rs\"}",
      "call_id": "0000000000000000000000001A",
      "name": "read",
      "type": "function_call"
    },
    {
      "call_id": "0000000000000000000000001A",
      "output": "fn main() {}",
      "type": "function_call_output"
    },
    {
      "content": [
        {
          "text": "Explain it",
          "type": "input_text"
        }
      ],
      "role": "user"
    }
  ],
  "instructions": "You are a test.",
  "max_output_tokens": 1024,
  "model": "test-model",
  "reasoning": {
    "summary": "auto"
  },
  "store": false,
  "stream": true,
  "tool_choice": "auto",
  "tools": [
    {
      "description": "Read a file",
      "name": "read",
      "parameters": {
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "type": "function"
    }
  ]
}
