{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "terminal": {
      "$ref": "#/$defs/TerminalConfig",
      "default": {
        "copy_on_select": false,
        "font_family": null,
        "font_size": 13,
        "ligatures": false,
        "scrollback": 10000,
        "shell": null,
        "shell_integration": true,
        "warn_multiline_paste": true
      }
    },
    "ui": {
      "$ref": "#/$defs/UiConfig",
      "default": {
        "locale": null,
        "theme": "dark"
      }
    },
    "updates": {
      "$ref": "#/$defs/UpdatesConfig",
      "default": {
        "check": true
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "TerminalConfig": {
      "type": "object",
      "properties": {
        "copy_on_select": {
          "type": "boolean",
          "default": false
        },
        "font_family": {
          "description": "Unset = bundled `JetBrains Mono`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "font_size": {
          "type": "integer",
          "format": "uint16",
          "default": 13,
          "maximum": 65535,
          "minimum": 0
        },
        "ligatures": {
          "type": "boolean",
          "default": false
        },
        "scrollback": {
          "description": "Lines kept per terminal.",
          "type": "integer",
          "format": "uint32",
          "default": 10000,
          "minimum": 0
        },
        "shell": {
          "description": "Shell id (`zsh`, `pwsh`, `wsl:Ubuntu`, ...). Unset = the user's login shell.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "shell_integration": {
          "description": "Inject `OSC 133` shell integration (needed for blocks).",
          "type": "boolean",
          "default": true
        },
        "warn_multiline_paste": {
          "description": "Ask before pasting text that contains line breaks.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "UiConfig": {
      "type": "object",
      "properties": {
        "locale": {
          "description": "UI language (`en`, `es-ES`). Unset = follow the OS.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "theme": {
          "description": "UI theme id.",
          "type": "string",
          "default": "dark"
        }
      },
      "additionalProperties": false
    },
    "UpdatesConfig": {
      "type": "object",
      "properties": {
        "check": {
          "description": "Check for updates on startup (the only request made without a configured provider).",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  }
}
