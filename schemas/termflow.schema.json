{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "catalog": {
      "$ref": "#/$defs/CatalogConfig",
      "default": {
        "fetch": null,
        "overrides": {}
      }
    },
    "permissions": {
      "description": "Extra `[[permissions]]` rules, applied after the built-in defaults (last match wins).",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Rule"
      }
    },
    "profiles": {
      "description": "Fallback profiles (`[profiles.<name>]`, `BUILD_PROMPT` §7.6).",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Profile"
      },
      "default": {}
    },
    "routes": {
      "description": "Scenario routes: which model runs background jobs, compaction, long context, vision.",
      "$ref": "#/$defs/Routes",
      "default": {
        "background": null,
        "compaction": null,
        "long_context": null,
        "vision": null
      }
    },
    "terminal": {
      "$ref": "#/$defs/TerminalConfig",
      "default": {
        "copy_on_select": false,
        "font_family": null,
        "font_size": 13,
        "ligatures": false,
        "scrollback": 10000,
        "shell": null,
        "shell_integration": true,
        "warn_multiline_paste": true
      }
    },
    "ui": {
      "$ref": "#/$defs/UiConfig",
      "default": {
        "locale": null,
        "theme": "mono-dark"
      }
    },
    "updates": {
      "$ref": "#/$defs/UpdatesConfig",
      "default": {
        "check": true
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "BudgetConfig": {
      "description": "Spend limits in USD (catalog prices of the model that actually served each request).",
      "type": "object",
      "properties": {
        "day_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "hard_stop": {
          "description": "Pause the agent at a limit instead of only warning.",
          "type": "boolean",
          "default": true
        },
        "month_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "session_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "warn_at": {
          "description": "Warn at this fraction of a limit.",
          "type": "number",
          "format": "double",
          "default": 0.8
        }
      },
      "additionalProperties": false
    },
    "CatalogConfig": {
      "type": "object",
      "properties": {
        "fetch": {
          "description": "Fetch models.dev daily (only once a provider is configured).",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "overrides": {
          "description": "`\"provider/model\" = { context = 128000, price = { input = 1.0, output = 2.0 } }`",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Override"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "Effect": {
      "type": "string",
      "enum": [
        "allow",
        "ask",
        "deny"
      ]
    },
    "Override": {
      "description": "`[catalog.overrides.\"provider/model\"]` in config: any field replaces the catalog's.",
      "type": "object",
      "properties": {
        "context": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "max_output": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "price": {
          "anyOf": [
            {
              "$ref": "#/$defs/Price"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reasoning": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "tools": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "vision": {
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Price": {
      "description": "USD per million tokens.",
      "type": "object",
      "properties": {
        "cache_read": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "cache_write": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "input": {
          "type": "number",
          "format": "double"
        },
        "output": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "input",
        "output"
      ]
    },
    "Profile": {
      "description": "An ordered fallback chain plus how to move along it. Chain entries are\n`provider/model@credential-label` (`@…` optional for local providers).",
      "type": "object",
      "properties": {
        "budget": {
          "$ref": "#/$defs/BudgetConfig",
          "default": {
            "day_usd": null,
            "hard_stop": true,
            "month_usd": null,
            "session_usd": null,
            "warn_at": 0.8
          }
        },
        "chain": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "handoff_note": {
          "description": "Tell the new model it is continuing another model's session (cross-vendor switches).",
          "type": "boolean",
          "default": true
        },
        "hysteresis_turns": {
          "description": "After a switch, stay on the fallback for at least this many requests.",
          "type": "integer",
          "format": "uint32",
          "default": 3,
          "minimum": 0
        },
        "on_content_policy": {
          "description": "Tried when the current model refuses (pick another vendor).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "on_context_overflow": {
          "description": "Tried when a request is too large for the current model.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "require": {
          "$ref": "#/$defs/Require",
          "default": {
            "reasoning": false,
            "tools": true,
            "vision": false
          }
        },
        "retry": {
          "$ref": "#/$defs/RetryConfig",
          "default": {
            "overloaded_retries": 2,
            "transient_max_wait_s": 10
          }
        },
        "switch_back": {
          "$ref": "#/$defs/SwitchBack",
          "default": "when_healthy"
        }
      },
      "additionalProperties": false
    },
    "Require": {
      "description": "Capabilities every candidate must have; unknown capabilities don't disqualify.",
      "type": "object",
      "properties": {
        "reasoning": {
          "type": "boolean",
          "default": false
        },
        "tools": {
          "type": "boolean",
          "default": true
        },
        "vision": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "RetryConfig": {
      "type": "object",
      "properties": {
        "overloaded_retries": {
          "type": "integer",
          "format": "uint32",
          "default": 2,
          "minimum": 0
        },
        "transient_max_wait_s": {
          "description": "Wait for a rate limit only if it lifts within this many seconds.",
          "type": "integer",
          "format": "uint64",
          "default": 10,
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "Routes": {
      "type": "object",
      "properties": {
        "background": {
          "description": "Chat titles and other background jobs.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "compaction": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "long_context": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "vision": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Rule": {
      "description": "One `[[permissions]]` entry. Unset matchers match anything.",
      "type": "object",
      "properties": {
        "command": {
          "description": "Bash command globs (`\"git status*\"`). For allow: every `;`/`&&`/`|` segment must match.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "effect": {
          "$ref": "#/$defs/Effect"
        },
        "path": {
          "description": "Path globs, matched against the absolute path (`\"**/.env*\"`).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "path_outside_workspace": {
          "description": "Matches when any path is outside the project folder.",
          "type": "boolean",
          "default": false
        },
        "tool": {
          "description": "Tool name(s) or globs (`\"*\"`, `\"write\"`, `[\"write\",\"edit\"]`).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "effect"
      ]
    },
    "SwitchBack": {
      "oneOf": [
        {
          "description": "Go back to the first model once it is healthy (after the hysteresis turns).",
          "type": "string",
          "const": "when_healthy"
        },
        {
          "description": "Stay on the fallback for the rest of the chat.",
          "type": "string",
          "const": "never"
        }
      ]
    },
    "TerminalConfig": {
      "type": "object",
      "properties": {
        "copy_on_select": {
          "type": "boolean",
          "default": false
        },
        "font_family": {
          "description": "Unset = bundled `JetBrains Mono`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "font_size": {
          "type": "integer",
          "format": "uint16",
          "default": 13,
          "maximum": 65535,
          "minimum": 0
        },
        "ligatures": {
          "type": "boolean",
          "default": false
        },
        "scrollback": {
          "description": "Lines kept per terminal.",
          "type": "integer",
          "format": "uint32",
          "default": 10000,
          "minimum": 0
        },
        "shell": {
          "description": "Shell id (`zsh`, `pwsh`, `wsl:Ubuntu`, ...). Unset = the user's login shell.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "shell_integration": {
          "description": "Inject `OSC 133` shell integration (needed for blocks).",
          "type": "boolean",
          "default": true
        },
        "warn_multiline_paste": {
          "description": "Ask before pasting text that contains line breaks.",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "UiConfig": {
      "type": "object",
      "properties": {
        "locale": {
          "description": "UI language (`en`, `es-ES`). Unset = follow the OS.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "theme": {
          "description": "UI theme id.",
          "type": "string",
          "default": "mono-dark"
        }
      },
      "additionalProperties": false
    },
    "UpdatesConfig": {
      "type": "object",
      "properties": {
        "check": {
          "description": "Check for updates on startup (the only request made without a configured provider).",
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  }
}
