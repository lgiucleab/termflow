{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TermFlow",
  "identifier": "com.flowlabs.termflow",
  "build": {
    "beforeDevCommand": "pnpm -C ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -C ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "TermFlow", "width": 1200, "height": 800, "minWidth": 640, "minHeight": 400 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "license": "Apache-2.0",
    "category": "DeveloperTool"
  }
}
